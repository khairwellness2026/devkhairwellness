# ============================================================================
# KHAIR INTERNATIONAL — ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and populate with your credentials
# ============================================================================

# Application Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Configuration (Get from Supabase Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudinary Media Configuration (Get from Cloudinary Dashboard)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Cloudinary Upload Preset (Optional signed/unsigned preset name)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=khair_uploads

# Optional Analytics & Verification
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

